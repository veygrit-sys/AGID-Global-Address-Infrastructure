{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-c",
  "directory": "agid-c",
  "language": "C",
  "packageName": "agid-c",
  "ecosystem": "systems",
  "packageManager": "CMake/manual",
  "runtime": "C11",
  "testCommand": "cc tests/parity.c src/agid.c -Iinclude -lm && ./a.out",
  "primaryUse": "C ABI and embedded integrations",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "generated-scaffold",
  "conformance": {
    "vectorFile": "agid-parity-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": true,
    "canonicalSpecPath": "../agid-spec/agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
