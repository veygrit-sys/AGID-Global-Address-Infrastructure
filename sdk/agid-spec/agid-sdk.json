{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-spec",
  "directory": "agid-spec",
  "language": "Spec",
  "packageName": "agid-spec",
  "ecosystem": "canonical-spec",
  "packageManager": "none",
  "runtime": "language-neutral",
  "testCommand": "Use generated SDK parity tests",
  "primaryUse": "Canonical AGID contract and parity vectors",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "canonical-spec",
  "conformance": {
    "vectorFile": "test-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": false,
    "canonicalSpecPath": "agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
