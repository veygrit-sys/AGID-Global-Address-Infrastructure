{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-go",
  "directory": "agid-go",
  "language": "Go",
  "packageName": "github.com/agid/agid-go",
  "ecosystem": "server",
  "packageManager": "Go modules",
  "runtime": "Go >=1.22",
  "testCommand": "go test ./...",
  "primaryUse": "Server services and delivery APIs",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "generated-scaffold",
  "conformance": {
    "vectorFile": "agid-parity-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": true,
    "canonicalSpecPath": "../agid-spec/agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
