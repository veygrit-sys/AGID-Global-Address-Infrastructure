{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-lua",
  "directory": "agid-lua",
  "language": "Lua",
  "packageName": "agid",
  "ecosystem": "scripting",
  "packageManager": "LuaRocks",
  "runtime": "Lua >=5.4",
  "testCommand": "lua test/parity_test.lua",
  "primaryUse": "Embedded scripting and lightweight devices",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "generated-scaffold",
  "conformance": {
    "vectorFile": "agid-parity-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": true,
    "canonicalSpecPath": "../agid-spec/agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
