{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-java",
  "directory": "agid-java",
  "language": "Java",
  "packageName": "org.agid:agid",
  "ecosystem": "enterprise",
  "packageManager": "Maven",
  "runtime": "Java >=17",
  "testCommand": "mvn test",
  "primaryUse": "Enterprise JVM and Android-compatible integrations",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "generated-scaffold",
  "conformance": {
    "vectorFile": "agid-parity-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": true,
    "canonicalSpecPath": "../agid-spec/agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
