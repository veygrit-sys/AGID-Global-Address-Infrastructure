{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-dotnet",
  "directory": "agid-dotnet",
  "language": "C#/.NET",
  "packageName": "Agid",
  "ecosystem": "enterprise",
  "packageManager": "NuGet/dotnet",
  "runtime": ".NET 8",
  "testCommand": "dotnet test",
  "primaryUse": "Enterprise, Windows, POS, and hotel systems",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "generated-scaffold",
  "conformance": {
    "vectorFile": "agid-parity-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": true,
    "canonicalSpecPath": "../agid-spec/agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
