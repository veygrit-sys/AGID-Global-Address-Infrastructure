{
  "schema": "agid-sdk-manifest-v1",
  "version": "1.0.0",
  "id": "agid-cpp",
  "directory": "agid-cpp",
  "language": "C++",
  "packageName": "agid-cpp",
  "ecosystem": "systems",
  "packageManager": "CMake/manual",
  "runtime": "C++17",
  "testCommand": "c++ tests/parity.cpp src/agid.cpp -Iinclude -std=c++17 && ./a.out",
  "primaryUse": "GIS engines, desktop, and native route systems",
  "generatedFrom": "agid-spec/agid-spec.json",
  "releaseStatus": "generated-scaffold",
  "conformance": {
    "vectorFile": "agid-parity-vectors.json",
    "requiredApis": [
      "encode",
      "decode",
      "cellBounds",
      "cellPolygon",
      "normalizeAgid",
      "isValidAgid",
      "validateAgid"
    ],
    "parityRequiredBeforePublish": true,
    "canonicalSpecPath": "../agid-spec/agid-spec.json"
  },
  "securityBoundary": {
    "publicAgidOnly": true,
    "forbiddenPublicFields": [
      "recipientName",
      "phoneNumber",
      "roomNumber",
      "unitNumber",
      "privateDeliveryInstruction",
      "ownerKey",
      "deviceKey",
      "aoidPrivatePayload",
      "encryptedAoidPayload"
    ]
  }
}
