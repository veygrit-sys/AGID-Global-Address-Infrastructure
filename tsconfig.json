{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@agid/addressql": [
        "./packages/addressql/src/index.ts"
      ],
      "@agid/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@agid/core": [
        "./packages/core/src/index.ts"
      ],
      "@agid/country-data": [
        "./packages/country-data/src/index.ts"
      ],
      "@agid/studio": [
        "./apps/studio/src/index.ts"
      ],
      "@agid/topography": [
        "./packages/topography/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "commercial",
    "reports"
  ]
}
