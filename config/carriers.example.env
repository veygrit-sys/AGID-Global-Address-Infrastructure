# Veygrit -ship carrier adapter. Copy these keys into the server secret store or local .env.
# Never expose this file with populated values to a browser bundle or commit real credentials.

# Internal server-to-server endpoint used after an Address Wallet consent check.
VEYGRIT_CARRIER_INTERNAL_API_KEY=replace-with-a-long-random-server-secret
# Durable product-code/routing persistence. Falls back to memory only for local development.
VEYGRIT_SHIP_POSTGRES_URL=

# Keep production traffic disabled until sandbox tests and a limited rollout are complete.
HEXASHIP_CARRIER_LIVE_TRAFFIC_ENABLED=false

# UPS Customer Integration Environment (CIE)
HEXASHIP_UPS_BASE_URL=https://wwwcie.ups.com
HEXASHIP_UPS_CLIENT_ID=
HEXASHIP_UPS_CLIENT_SECRET=
HEXASHIP_UPS_ACCOUNT_NUMBER=
HEXASHIP_UPS_BILLING_ACCOUNT_NUMBER=
HEXASHIP_UPS_PICKUP_ACCOUNT_NUMBER=
# UPS REST defaults. Shipment/Void are never automatically retried.
HEXASHIP_UPS_API_VERSION=v2409
HEXASHIP_UPS_TRANSACTION_SOURCE=veygrit-ship
HEXASHIP_UPS_TIMEOUT_MS=10000
HEXASHIP_UPS_MAX_SAFE_RETRIES=3
HEXASHIP_UPS_RETRY_BASE_DELAY_MS=250
HEXASHIP_UPS_RETRY_MAX_DELAY_MS=30000
HEXASHIP_UPS_TOKEN_EXPIRY_SKEW_MS=60000
# Test servers only. Leave false for UPS CIE and production.
HEXASHIP_UPS_ALLOW_CUSTOM_BASE_URL=false

# DHL Express MyDHL test environment
HEXASHIP_DHL_MYDHL_BASE_URL=https://express.api.dhl.com/mydhlapi/test
HEXASHIP_DHL_MYDHL_USERNAME=
HEXASHIP_DHL_MYDHL_PASSWORD=
HEXASHIP_DHL_ACCOUNT_NUMBER=
HEXASHIP_DHL_PICKUP_ACCOUNT_NUMBER=
HEXASHIP_DHL_DUTY_ACCOUNT_NUMBER=

# DHL eCommerce Americas v4 sandbox. This is a separate account/onboarding from MyDHL Express.
HEXASHIP_DHL_ECOMMERCE_BASE_URL=https://api-sandbox.dhlecs.com
HEXASHIP_DHL_ECOMMERCE_CLIENT_ID=
HEXASHIP_DHL_ECOMMERCE_CLIENT_SECRET=
HEXASHIP_DHL_ECOMMERCE_PICKUP_ACCOUNT=
HEXASHIP_DHL_ECOMMERCE_DISTRIBUTION_CENTER=
HEXASHIP_DHL_ECOMMERCE_TOKEN_EXPIRY_SKEW_MS=900000

# Shared DHL transport policy. Read-only calls retry; label/manifest/return/void writes do not.
HEXASHIP_DHL_TIMEOUT_MS=10000
HEXASHIP_DHL_MAX_SAFE_RETRIES=3
HEXASHIP_DHL_RETRY_BASE_DELAY_MS=250
HEXASHIP_DHL_RETRY_MAX_DELAY_MS=30000
# Controlled local mock servers only. Keep false in deployment.
HEXASHIP_DHL_ALLOW_CUSTOM_BASE_URL=false

# Veygrit -ship persistent operational store. Use a pooled PostgreSQL URL in production.
VEYGRIT_SHIP_POSTGRES_URL=
VEYGRIT_SHIP_POSTGRES_POOL_MAX=10
VEYGRIT_SHIP_POSTGRES_STATEMENT_TIMEOUT_MS=15000
VEYGRIT_SHIP_WORKER_BATCH_SIZE=20
VEYGRIT_SHIP_WORKER_CONCURRENCY=4
VEYGRIT_SHIP_WORKER_LEASE_SECONDS=60
VEYGRIT_SHIP_WEBHOOK_TIMEOUT_MS=10000
VEYGRIT_SHIP_GUEST_POSTGRES_URL=
VEYGRIT_SHIP_GUEST_FINGERPRINT_SECRET=
VEYGRIT_SHIP_GUEST_SESSION_LIFETIME_MS=7200000
VEYGRIT_SHIP_GUEST_SESSIONS_PER_HOUR=10
VEYGRIT_SHIP_AWS_SECRET_PREFIX=veygrit-ship/carriers
VEYGRIT_SHIP_GCP_SECRET_PROJECT=
VEYGRIT_SHIP_GCP_SECRET_PREFIX=veygrit-ship
VEYGRIT_SHIP_AZURE_KEY_VAULT_URL=
VEYGRIT_SHIP_AZURE_SECRET_PREFIX=veygrit-ship
VEYGRIT_SHIP_LABEL_OBJECT_PROVIDER=aws-s3
VEYGRIT_SHIP_LABEL_S3_BUCKET=
VEYGRIT_SHIP_LABEL_S3_KMS_KEY_ID=
VEYGRIT_SHIP_LABEL_GCS_BUCKET=
VEYGRIT_SHIP_LABEL_GCS_KMS_KEY_NAME=
VEYGRIT_SHIP_LABEL_AZURE_ACCOUNT_URL=
VEYGRIT_SHIP_LABEL_AZURE_CONTAINER=
