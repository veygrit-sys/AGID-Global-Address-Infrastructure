{
  "repository": "address-morphism-theory",
  "status": "local-template",
  "remoteCreated": false,
  "kind": "independent-theory-repository",
  "externalSeedPath": "reports/address-morphism-theory-review",
  "seedAvailability": "external-local",
  "pythonRequirementsPath": "reports/address-research-repositories/address-morphism-theory/requirements.txt",
  "canonicalBoundaryDoc": "docs/product/address-morphism-repository-boundary.md",
  "ownerPolicy": "Run repository creation preflight before any remote creation.",
  "primaryAudience": [
    "researchers",
    "standards reviewers",
    "privacy-proof implementers",
    "AGID protocol implementers"
  ],
  "owns": [
    "AMT manuscripts",
    "formal model registry",
    "claim maps",
    "verification notes",
    "local publication build scripts"
  ],
  "doesNotOwn": [
    "AGID runtime services",
    "merchant or carrier integrations",
    "country or postal data packs",
    "private operational material"
  ],
  "privacyBoundary": {
    "allowed": [
      "public theory text",
      "synthetic examples",
      "formal definitions",
      "non-claim maps"
    ],
    "prohibitedMaterial": [
      "raw_private_address",
      "recipient_identity",
      "witness_file",
      "private_key",
      "proof_secret",
      "production_credential",
      "raw_carrier_payload"
    ]
  },
  "verification": {
    "familyPlan": "npx tsx --test reports/address-research-repositories/tests/repository-family-plan.test.ts",
    "externalSeedRepository": "Run npm run verify from a separately checked-out address-morphism-theory seed."
  }
}
