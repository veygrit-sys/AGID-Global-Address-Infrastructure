{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RateQuote v0.1",
  "description": "Synthetic normalized rate quote contract for Address Stripe. It estimates options from refs and carrier capability metadata without claiming live carrier capacity or SLA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rate_quote_ref",
    "shipment_intent_ref",
    "objective",
    "quoted_options",
    "capability_warnings",
    "privacy",
    "non_claims"
  ],
  "properties": {
    "version": { "const": "rate-quote-v0.1" },
    "rate_quote_ref": { "type": "string", "minLength": 1 },
    "shipment_intent_ref": { "type": "string", "minLength": 1 },
    "objective": { "enum": ["fastest", "cheapest", "balanced", "risk-minimized"] },
    "quoted_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_ref", "carrier_alias", "service_level", "price_estimate_ref", "eta_window_ref", "score"],
        "properties": {
          "option_ref": { "type": "string", "minLength": 1 },
          "carrier_alias": { "type": "string", "minLength": 1 },
          "service_level": { "type": "string", "minLength": 1 },
          "price_estimate_ref": { "type": "string", "minLength": 1 },
          "eta_window_ref": { "type": "string", "minLength": 1 },
          "score": { "type": "number" }
        }
      }
    },
    "capability_warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_address", "production_traffic", "carrier_credentials_present", "commercial_rate_secret_present"],
      "properties": {
        "contains_raw_address": { "const": false },
        "production_traffic": { "const": false },
        "carrier_credentials_present": { "const": false },
        "commercial_rate_secret_present": { "const": false }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
