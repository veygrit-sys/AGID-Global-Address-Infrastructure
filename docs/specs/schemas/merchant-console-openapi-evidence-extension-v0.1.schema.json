{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnportinfo-design.github.io/agid/schemas/merchant-console-openapi-evidence-extension-v0.1.schema.json",
  "title": "Merchant Console OpenAPI Evidence Fixtures Extension Profile v0.1",
  "description": "Merchant Console onboarding profile for the generic x-agid-evidence-fixtures OpenAPI extension. This profile fixes the exact local fixture, schema, verifier commands, boundary, forbidden-material names, and non-claims used by onboarding evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflightFixture",
    "historyFixture",
    "evidenceFixture",
    "evidenceSchema",
    "verifierCommand",
    "aggregateVerifierCommand",
    "managedServiceBoundary",
    "localOnly",
    "forbiddenMaterial",
    "nonClaims",
    "nonClaimsProfile"
  ],
  "properties": {
    "preflightFixture": {
      "const": "docs/specs/fixtures/merchant-console-onboarding-v0.1.json"
    },
    "historyFixture": {
      "const": "docs/specs/fixtures/merchant-console-onboarding-v0.1.json"
    },
    "evidenceFixture": {
      "const": "docs/specs/fixtures/merchant-console-onboarding-v0.1.json"
    },
    "evidenceSchema": {
      "const": "docs/specs/schemas/merchant-console-onboarding-v0.1.schema.json"
    },
    "verifierCommand": {
      "const": "npm run verify:merchant-console-ec-plugin"
    },
    "aggregateVerifierCommand": {
      "const": "npm run verify:address-login-spec"
    },
    "managedServiceBoundary": {
      "const": "delivery-gateway-carrier-api"
    },
    "localOnly": {
      "const": true
    },
    "forbiddenMaterial": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "raw_address"
          }
        },
        {
          "contains": {
            "const": "address_line_1"
          }
        },
        {
          "contains": {
            "const": "address_line_2"
          }
        },
        {
          "contains": {
            "const": "recipient_name"
          }
        },
        {
          "contains": {
            "const": "recipient_phone"
          }
        },
        {
          "contains": {
            "const": "carrier_api_key"
          }
        },
        {
          "contains": {
            "const": "carrier_credential"
          }
        },
        {
          "contains": {
            "const": "raw_carrier_payload"
          }
        },
        {
          "contains": {
            "const": "raw_label_payload"
          }
        },
        {
          "contains": {
            "const": "webhook_secret"
          }
        },
        {
          "contains": {
            "const": "production_webhook_secret"
          }
        },
        {
          "contains": {
            "const": "proof_witness"
          }
        },
        {
          "contains": {
            "const": "proof_secret"
          }
        },
        {
          "contains": {
            "const": "private_key"
          }
        },
        {
          "contains": {
            "const": "provider_id_token"
          }
        },
        {
          "contains": {
            "const": "provider_access_token"
          }
        },
        {
          "contains": {
            "const": "provider_refresh_token"
          }
        },
        {
          "contains": {
            "const": "raw_provider_profile"
          }
        }
      ]
    },
    "nonClaims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "not-raw-address-intake"
          }
        },
        {
          "contains": {
            "const": "not-proof-witness-intake"
          }
        },
        {
          "contains": {
            "const": "not-provider-token-intake"
          }
        },
        {
          "contains": {
            "const": "not-raw-carrier-payload-intake"
          }
        },
        {
          "contains": {
            "const": "not-live-carrier-credential"
          }
        },
        {
          "contains": {
            "const": "not-raw-address-disclosure"
          }
        },
        {
          "contains": {
            "const": "not-production-dhl-ups-traffic"
          }
        },
        {
          "contains": {
            "const": "not-carrier-specific-address-form"
          }
        },
        {
          "contains": {
            "const": "not-raw-address-callback"
          }
        }
      ]
    },
    "nonClaimsProfile": {
      "const": "merchant-console-onboarding-v0.1"
    }
  }
}
