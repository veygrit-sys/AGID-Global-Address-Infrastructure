{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addressql.org/schemas/addressql-carrier-trust-store-v1.schema.json",
  "title": "AddressQL Carrier Trust Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": {
      "const": "addressql-carrier-trust-store-v1"
    },
    "keys": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "carrierId",
          "countryCodes",
          "publicKey",
          "status",
          "validFrom",
          "validUntil"
        ],
        "properties": {
          "carrierId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "countryCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "publicKey": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----"
          },
          "status": {
            "enum": ["active", "revoked", "rotated"]
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
