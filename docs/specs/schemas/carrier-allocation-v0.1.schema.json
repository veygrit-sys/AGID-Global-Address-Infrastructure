{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CarrierAllocation v0.1",
  "description": "Synthetic carrier allocation contract for Address Stripe. It selects a carrier option from refs and policy constraints without purchasing a label or deciding settlement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "carrier_allocation_ref",
    "shipment_intent_ref",
    "rate_quote_ref",
    "wallet_consent_ref",
    "selected_option_ref",
    "selected_carrier_alias",
    "selection_reason_codes",
    "status",
    "privacy",
    "non_claims"
  ],
  "properties": {
    "version": { "const": "carrier-allocation-v0.1" },
    "carrier_allocation_ref": { "type": "string", "minLength": 1 },
    "shipment_intent_ref": { "type": "string", "minLength": 1 },
    "rate_quote_ref": { "type": "string", "minLength": 1 },
    "wallet_consent_ref": { "type": "string", "minLength": 1 },
    "selected_option_ref": { "type": "string", "minLength": 1 },
    "selected_carrier_alias": { "type": "string", "minLength": 1 },
    "selection_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["allocated", "requires_manual_review", "blocked"] },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_address", "production_traffic", "carrier_credentials_present", "private_policy_body_present"],
      "properties": {
        "contains_raw_address": { "const": false },
        "production_traffic": { "const": false },
        "carrier_credentials_present": { "const": false },
        "private_policy_body_present": { "const": false }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
