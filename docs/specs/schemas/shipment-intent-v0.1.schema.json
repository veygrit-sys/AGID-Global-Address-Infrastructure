{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShipmentIntent v0.1",
  "description": "Synthetic ref-first shipment intent contract for Address Stripe. It captures a merchant shipment request without raw private address, carrier credential, proof witness, or production carrier material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "intent_id",
    "merchant_ref",
    "recipient_token_ref",
    "parcel_profile_ref",
    "service_preference",
    "address_validation_ref",
    "wallet_consent_ref",
    "status",
    "required_next_action",
    "privacy",
    "non_claims"
  ],
  "properties": {
    "version": { "const": "shipment-intent-v0.1" },
    "intent_id": { "type": "string", "minLength": 1 },
    "merchant_ref": { "type": "string", "minLength": 1 },
    "recipient_token_ref": { "type": "string", "minLength": 1 },
    "parcel_profile_ref": { "type": "string", "minLength": 1 },
    "service_preference": { "enum": ["fastest", "cheapest", "balanced", "risk-minimized"] },
    "address_validation_ref": { "type": "string", "minLength": 1 },
    "wallet_consent_ref": { "type": "string", "minLength": 1 },
    "status": { "enum": ["requires_validation", "requires_wallet_consent", "requires_rate_quote", "ready_for_rate_quote", "blocked"] },
    "required_next_action": { "enum": ["none", "validate_address", "request_wallet_consent", "quote_rates", "manual_review"] },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_address", "production_traffic", "carrier_credentials_present", "log_safe"],
      "properties": {
        "contains_raw_address": { "const": false },
        "production_traffic": { "const": false },
        "carrier_credentials_present": { "const": false },
        "log_safe": { "const": true }
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
