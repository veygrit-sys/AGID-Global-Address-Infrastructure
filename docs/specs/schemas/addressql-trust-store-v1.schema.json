{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addressql.org/schemas/addressql-trust-store-v1.schema.json",
  "title": "AddressQL Ed25519 Trust Store v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "keys"
  ],
  "properties": {
    "version": {
      "const": "addressql-trust-store-v1"
    },
    "keys": {
      "type": "object",
      "minProperties": 0,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^-----BEGIN PUBLIC KEY-----"
      }
    }
  }
}
