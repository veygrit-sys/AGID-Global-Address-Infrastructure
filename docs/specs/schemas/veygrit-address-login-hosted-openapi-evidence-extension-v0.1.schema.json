{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnportinfo-design.github.io/agid/schemas/veygrit-address-login-hosted-openapi-evidence-extension-v0.1.schema.json",
  "title": "Veygrit Hosted Address Login OpenAPI Evidence Fixtures Extension Profile v0.1",
  "description": "Veygrit Hosted Address Login profile for the generic x-agid-evidence-fixtures OpenAPI extension. This profile fixes the exact local fixture, schema, verifier commands, boundary, and non-claims used by hosted Address Login conformance vectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflightFixture",
    "historyFixture",
    "evidenceFixture",
    "evidenceSchema",
    "verifierCommand",
    "aggregateVerifierCommand",
    "managedServiceBoundary",
    "localOnly",
    "forbiddenMaterial",
    "nonClaims",
    "nonClaimsProfile"
  ],
  "properties": {
    "preflightFixture": {
      "const": "docs/specs/fixtures/veygrit-address-login-hosted-v0.1.json"
    },
    "historyFixture": {
      "const": "docs/specs/fixtures/veygrit-address-login-hosted-v0.1.json"
    },
    "evidenceFixture": {
      "const": "docs/specs/fixtures/veygrit-address-login-hosted-v0.1.json"
    },
    "evidenceSchema": {
      "const": "docs/specs/schemas/veygrit-address-login-hosted-fixture-v0.1.schema.json"
    },
    "verifierCommand": {
      "const": "npm run verify:veygrit-address-login-hosted"
    },
    "aggregateVerifierCommand": {
      "const": "npm run verify:address-login-spec"
    },
    "managedServiceBoundary": {
      "const": "fixture-only-not-hosted-address-login"
    },
    "localOnly": {
      "const": true
    },
    "forbiddenMaterial": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "raw_address"
          }
        },
        {
          "contains": {
            "const": "recipient_phone"
          }
        },
        {
          "contains": {
            "const": "proof_witness"
          }
        },
        {
          "contains": {
            "const": "private_key"
          }
        },
        {
          "contains": {
            "const": "biometric_template"
          }
        },
        {
          "contains": {
            "const": "production_webhook_secret"
          }
        }
      ]
    },
    "nonClaims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "not-raw-address-intake"
          }
        },
        {
          "contains": {
            "const": "not-proof-witness-intake"
          }
        },
        {
          "contains": {
            "const": "not-production-credential-intake"
          }
        }
      ]
    },
    "nonClaimsProfile": {
      "const": "veygrit-address-login-hosted-v0.1"
    }
  }
}
