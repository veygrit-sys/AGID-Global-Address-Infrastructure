{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnportinfo-design.github.io/agid/schemas/trade-gateway-openapi-evidence-extension-v0.1.schema.json",
  "title": "Trade Gateway OpenAPI Evidence Fixtures Extension Profile v0.1",
  "description": "Trade Gateway profile for the generic x-agid-evidence-fixtures OpenAPI extension. This profile fixes the exact local idempotency fixture, schema, verifier commands, boundary, forbidden-material names, and non-claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflightFixture",
    "historyFixture",
    "evidenceFixture",
    "evidenceSchema",
    "verifierCommand",
    "aggregateVerifierCommand",
    "managedServiceBoundary",
    "localOnly",
    "forbiddenMaterial",
    "nonClaims",
    "nonClaimsProfile"
  ],
  "properties": {
    "preflightFixture": {
      "const": "docs/specs/fixtures/vey-trade-gateway-idempotency-v0.1.json"
    },
    "historyFixture": {
      "const": "docs/specs/fixtures/vey-trade-gateway-idempotency-v0.1.json"
    },
    "evidenceFixture": {
      "const": "docs/specs/fixtures/vey-trade-gateway-idempotency-v0.1.json"
    },
    "evidenceSchema": {
      "const": "docs/specs/schemas/vey-trade-gateway-idempotency-v0.1.schema.json"
    },
    "verifierCommand": {
      "const": "npm run verify:vey-trade-gateway-idempotency-fixture-schema"
    },
    "aggregateVerifierCommand": {
      "const": "npm run verify:vey-trading"
    },
    "managedServiceBoundary": {
      "const": "trade-gateway-local-idempotent-intent"
    },
    "localOnly": {
      "const": true
    },
    "forbiddenMaterial": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "raw_address"
          }
        },
        {
          "contains": {
            "const": "raw_agid"
          }
        },
        {
          "contains": {
            "const": "raw_aoid"
          }
        },
        {
          "contains": {
            "const": "recipient_name"
          }
        },
        {
          "contains": {
            "const": "recipient_phone"
          }
        },
        {
          "contains": {
            "const": "counterparty_contact"
          }
        },
        {
          "contains": {
            "const": "proof_witness"
          }
        },
        {
          "contains": {
            "const": "proof_secret"
          }
        },
        {
          "contains": {
            "const": "private_key"
          }
        },
        {
          "contains": {
            "const": "production_credential"
          }
        },
        {
          "contains": {
            "const": "production_webhook_secret"
          }
        },
        {
          "contains": {
            "const": "contract_body"
          }
        },
        {
          "contains": {
            "const": "customs_document_body"
          }
        }
      ]
    },
    "nonClaims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "allOf": [
        {
          "contains": {
            "const": "not-raw-address-intake"
          }
        },
        {
          "contains": {
            "const": "not-proof-witness-intake"
          }
        },
        {
          "contains": {
            "const": "not-production-traffic"
          }
        },
        {
          "contains": {
            "const": "not-production-trading-venue"
          }
        },
        {
          "contains": {
            "const": "not-payment-settlement"
          }
        },
        {
          "contains": {
            "const": "not-customs-clearance"
          }
        },
        {
          "contains": {
            "const": "not-legal-or-financial-advice"
          }
        },
        {
          "contains": {
            "const": "not-identity-truth-or-sanctions-outcome"
          }
        }
      ]
    },
    "nonClaimsProfile": {
      "const": "trade-gateway-idempotency-v0.1"
    }
  }
}
