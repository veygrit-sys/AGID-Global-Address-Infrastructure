{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addressql.org/schemas/addressql-runtime-release-state-v1.schema.json",
  "title": "AddressQL Runtime Release State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastSequence",
    "lastReleaseDigest",
    "lastConfigDigest",
    "updatedAt"
  ],
  "properties": {
    "version": {
      "const": "addressql-runtime-release-state-v1"
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 1
    },
    "lastReleaseDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lastConfigDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
