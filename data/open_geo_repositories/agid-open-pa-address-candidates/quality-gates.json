{
  "schemaVersion": "agid-open-p1-quality-gates-v0.1",
  "repository": "agid-open-pa-address-candidates",
  "manualFallbackPolicy": "required-until-conformance-pass",
  "gates": [
    {
      "id": "no-raw-personal-addresses",
      "required": true
    },
    {
      "id": "no-recipient-records",
      "required": true
    },
    {
      "id": "source-license-ledger-required",
      "required": true
    },
    {
      "id": "one-present-core-role-must-be-named",
      "required": true
    },
    {
      "id": "three-missing-core-roles-must-be-fixtured-or-blocked",
      "required": true
    },
    {
      "id": "manual-fallback-visible",
      "required": true
    },
    {
      "id": "redistribution-review-before-import",
      "required": true
    },
    {
      "id": "no-delivery-postal-or-legal-overclaim",
      "required": true
    },
    {
      "id": "promotion-to-p2-requires-conformance-pass",
      "required": true
    }
  ]
}
