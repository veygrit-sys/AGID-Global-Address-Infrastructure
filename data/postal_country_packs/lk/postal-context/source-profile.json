  "data_grain": "Future typed source-released postal assignments, separate from initial UI options, administrative layers and private contact fields.",
  "normalization": {
    "postcode": "Preserve five ASCII digits as strings, including leading zeros; do not coerce numbers or treat the selector placeholder as a postcode.",
    "names": "Preserve si/ta/en and original language/script, Unicode NFC, stable source IDs and parent context. Do not equate transliterations or same-name localities.",
    "time": "Separate observed_at, source edition/date, valid_from and valid_to; unknown stays null."
  },
  "data_minimization": {
    "feature_queries_performed": 0,
    "personal_contact_values_acquired": 0,
    "excluded_fields": [
      "gnd_officer_name",
      "gnd_officer_phone",
      "recipient",
      "customer",
      "household",
      "owner",
      "title",
      "unreviewed_free_text"
    ],
    "future_intake_rule": "Exact reviewed public-field allowlist, not outFields=*; administrative metadata review does not authorize features or sensitive layers."
  },
  "address_display": {
    "postal_context": "Source-linked code and permitted administrative/locality context only.",
    "civic_number": "Requires a separate explicit licensed civic relation.",
    "building": "Requires a separate explicit licensed building relation; no nearest-building, containment or model inference.",
    "agid_cell": "Independent coordinate index only."
  }
