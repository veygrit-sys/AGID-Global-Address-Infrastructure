  "artifact_partitions": [
    {
      "id": "typed-five-digit-observation",
      "contents": "Pinned postcode text, delivery office, observed time, validity and operator authority."
    },
    {
      "id": "po-box-and-subscriber",
      "contents": "BP number retained as a separate delivery object; subscriber and key records remain gated."
    },
    {
      "id": "official-postal-surface",
      "contents": "Exact rights-cleared operator catchment explicitly bound to the same postal object, edition and validity."
    },
    {
      "id": "derived-postal-review-surface",
      "contents": "Optional non-canonical surface with permitted inputs, method, uncertainty, exclusions, topology, time, version and digests."
    },
    {
      "id": "administrative-and-toponymic-context",
      "contents": "Region, department, arrondissement, commune, locality and permitted geometry kept separate from postal assignment."
    },
    {
      "id": "civic-address",
      "contents": "Rights-cleared authoritative civic addresses with stable identifiers, provenance and visibility."
    },
    {
      "id": "nicad-cadastre",
      "contents": "Controlled parcel identifiers and exact permitted geometry kept separate from postal and building objects."
    },
    {
      "id": "licensed-building",
      "contents": "BaseGeo or other rights-cleared buildings plus stable explicit address relations under pinned contractual terms."
    },
    {
      "id": "community-odbl",
      "contents": "OSM roads, names, addresses and buildings in a separate ODbL-compatible validation partition."
    },
    {
      "id": "private-and-restricted",
      "contents": "Recipients, subscribers, phones, households, BP holders, owners, occupants, titles, deliveries, queries, credentials and controlled features."
    }
  ],
