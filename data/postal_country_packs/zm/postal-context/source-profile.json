    {
      "id": "official-postal-surface",
      "contents": "Exact rights-cleared operator or regulator catchment explicitly bound to the same postal object, edition and validity."
    },
    {
      "id": "derived-postal-review-surface",
      "contents": "Optional non-canonical surface with permitted inputs, method, uncertainty, exclusions, topology, time, version and digests."
    },
    {
      "id": "administrative-and-toponymic-context",
      "contents": "Province, district, ward, locality and permitted geometry kept separate from postal assignment."
    },
    {
      "id": "national-and-civic-address",
      "contents": "Operational rights-cleared national or authoritative civic addresses with stable identifiers, provenance and visibility."
    },
    {
      "id": "cadastre-and-building",
      "contents": "Rights-cleared parcels and buildings plus stable explicit address relations, with private fields removed."
    },
    {
      "id": "community-odbl",
      "contents": "OSM roads, places, addresses and buildings in a separate ODbL-compatible validation partition."
    },
    {
      "id": "private-and-restricted",
      "contents": "Recipients, holders, phones, households, residents, owners, titles, correspondence, queries, credentials and access-controlled features."
