  "global_fallback_policy": {
    "permitted": [
      "licensed UPU reference after national source check",
      "OSM and OpenAddresses discrepancy validation under source licences",
      "GeoNames syntax or locality fallback",
      "AGID indexing without postal-authority relabelling"
    ],
    "prohibited": [
      "fallback row promoted over pinned Ministry assignment",
      "OSM block or parcel presented as official postal polygon",
      "nearest feature presented as PACI address or building",
      "coverage used as sovereignty evidence"
