{
  "schema_version": "agid-postal-kw-source-profile-v0.1",
  "country_code": "KW",
  "artifact_scope": "metadata-only-contract-seed",
  "redistribution_classes": [
    {
      "id": "R0_synthetic",
      "meaning": "AGID-created metadata and non-production fixtures only."
    },
    {
      "id": "R1_public_reference",
      "meaning": "Public official pages, specifications, catalogs or viewers retained as references; access does not imply row or artifact redistribution rights."
    },
    {
      "id": "R2_source_specific_reuse",
      "meaning": "An exact artifact whose declared licence or permission permits recorded fields and derivatives, with provider, edition, coverage, schema, CRS, validity, attribution and digest pinned."
    },
    {
      "id": "R3_controlled_approval_or_contract",
      "meaning": "Registered, request-delivered, licensed, credentialed or restricted material used and redistributed only as specifically permitted."
    },
    {
      "id": "R4_validation_only",
      "meaning": "Personal, query, unclear-license, search-only, viewer-only or non-redistributable evidence may detect discrepancies but cannot become public output."
    }
  ],
  "sources": [
    {
      "bundled_here": false,
      "source_id": "kuwait-post",
      "provider": "Ministry of Communications, State of Kuwait",
      "source_url": "https://www.moc.gov.kw/en/important-links?tab=2",
      "role": [
        "official-current-postcode-tables",
        "block-number-assignment",
        "po-box-range-assignment"
      ],
      "production_scope": "Official tables expose governorate, area, block number and postcode separately from P.O. box from/to ranges and postcode. An exact captured row can validate assignment class and current relation; public web access does not establish complete history, bulk API, geometry, delivery entitlement or redistribution permission.",
      "assignment_authority": "official_government_postal_assignment_when_exact_row_is_pinned",
      "geometry_authority": "none",
      "validation_readiness": "exact_table_row_capture_time_terms_and_digest_required",
      "redistribution_class": "R4_validation_only",
      "prohibited_claims": [
        "web-table-is-bulk-licence",
        "block-row-is-polygon",
        "po-box-range-is-catchment-or-building"
      ]
    },
    {
      "bundled_here": false,
      "source_id": "upu-kuwait-addressing",
      "provider": "Universal Postal Union with Kuwait Ministry of Communications",
      "source_url": "https://www.upu.int/UPU/media/upu/PostalEntitiesFiles/addressingUnit/kwtEn.pdf",
      "role": [
        "current-five-digit-display",
        "home-and-po-box-address-order",
        "block-zone-sector-semantics"
      ],
      "production_scope": "The UPU sheet specifies five digits to the left of the locality and gives separate P.O. box and home-delivery examples with block, zone, street and building context. It is addressing metadata, not a current assignment database, polygon, delivery point or building relation.",
      "assignment_authority": "official_addressing_semantics_only",
      "geometry_authority": "none",
      "validation_readiness": "metadata_only_not_assignment_evidence",
      "redistribution_class": "R1_public_reference",
      "prohibited_claims": [
        "example-is-current-assignment",
        "coding-diagram-is-polygon",
        "po-box-example-is-building"
      ]
    },
    {
      "bundled_here": false,
      "source_id": "paci-kuwait-finder",
      "provider": "Public Authority for Civil Information, Kuwait",
      "source_url": "https://pacigis.github.io/?language=en",
      "role": [
        "official-address-and-landmark-viewer",
        "location-validation",
        "map-reference"
      ],
      "production_scope": "Kuwait Finder exposes PACI-based address and landmark reference. Its terms describe the data as informational and as-is, disclaim boundary accuracy, and reject legal, engineering and surveying use. Exact terms, response provenance and permission are required; viewer content is not bulk data or canonical postal geometry.",
      "assignment_authority": "official_civil_address_reference_only",
      "geometry_authority": "informational_map_only_with_boundary_accuracy_disclaimer",
      "validation_readiness": "viewer_validation_only_until_exact_permission_and_artifact_pinned",
      "redistribution_class": "R4_validation_only",
      "prohibited_claims": [
        "viewer-is-bulk-address-api",
        "map-boundary-is-legal-or-postal",
        "paci-map-grants-redistribution"
      ]
    },
    {
      "bundled_here": false,
      "source_id": "paci-kuwait-address-services",
      "provider": "Public Authority for Civil Information, Kuwait",
      "source_url": "https://services.paci.gov.kw/",
      "role": [
        "official-civil-address-authority",
        "address-availability",
        "automated-unit-or-property-number"
      ],
      "production_scope": "PACI registers civil addresses and supplies address, entity and building services. Exact permitted public address identifiers can support an explicit relation. Civil ID, household, occupant, owner, tenant, lease, phone, application and query data are controlled or personal and excluded.",
      "assignment_authority": "official_civil_address_identifier_only",
      "geometry_authority": "none_unless_exact_separate_permitted_spatial_artifact_is_pinned",
      "validation_readiness": "controlled_query_or_permission_required",
      "redistribution_class": "R3_controlled_approval_or_contract",
      "prohibited_claims": [
        "civil-id-is-public-address-key",
        "address-availability-response-is-bulk-data",
        "automated-number-identifies-person"
      ]
    },
    {
      "bundled_here": false,
      "source_id": "paci-kuwait-building-register",
      "provider": "Public Authority for Civil Information, Kuwait",
      "source_url": "https://services.paci.gov.kw/applications-guide",
      "role": [
        "official-building-registration",
        "automated-property-number",
        "building-address-identity"
      ],
      "production_scope": "PACI workflows register or update buildings and issue automated numbers for properties or vacant parcels using controlled applications and supporting documents. Identifier semantics may support explicit joins, but workflows do not provide an unrestricted building footprint, ownership file or public address-building crosswalk.",
      "assignment_authority": "official_building_and_property_identifier_only",
      "geometry_authority": "none_without_exact_permitted_feature_and_stable_relation",
      "validation_readiness": "controlled_registration_evidence_not_public_bulk_output",
      "redistribution_class": "R3_controlled_approval_or_contract",
      "prohibited_claims": [
        "registration-form-is-building-dataset",
        "automated-number-is-footprint",
        "owner-or-document-is-public-output"
      ]
    },
    {
      "bundled_here": false,
      "source_id": "kuwait-municipality-parcels",
      "provider": "Kuwait Municipality",
      "source_url": "https://gismaps.baladia.gov.kw/arcgis/rest/services/KM/KM_Dynamic_All_Parcels/MapServer/layers",
      "role": [
        "parcel-and-base-map-reference",
        "geometry-candidate",
        "crs-reference"
      ],
      "production_scope": "Municipality ArcGIS metadata exposes parcels and base-map layers with GIS identifiers and Kuwait-specific projected CRS. Exact service terms, layer, edition, fields, coverage, topology, CRS transformation and digest are required. Parcel geometry is not a postcode block, building footprint, address relation or ownership output.",
      "assignment_authority": "none_municipal_geometry_only",
      "geometry_authority": "official_municipal_parcel_or_base_map_feature_only",
      "validation_readiness": "metadata_only_until_exact_terms_artifact_and_digest_pinned",
      "redistribution_class": "R4_validation_only",
      "prohibited_claims": [
        "arcgis-queryability-is-licence",
        "parcel-is-postal-or-building",
        "gis-number-is-paci-relation-without-crosswalk"
      ]
    },
    {
      "bundled_here": false,
      "source_id": "kuwait-csb-census-gis",
      "provider": "Central Statistical Bureau, Kuwait",
      "source_url": "https://gis.csb.gov.kw/en/",
      "role": [
        "historical-governorate-and-settlement-context",
        "municipal-block-statistics",
        "validation"
      ],
      "production_scope": "The official 2011 census portal presents statistics for country, governorate, population settlement and municipal block levels and disclaims accuracy, timeliness and completeness. It is historical statistical context, not current postal assignment, canonical postal geometry or building identity.",
      "assignment_authority": "none_historical_statistical_context_only",
      "geometry_authority": "official_statistical_visualization_only_with_disclaimer",
      "validation_readiness": "historical_validation_only",
      "redistribution_class": "R4_validation_only",
      "prohibited_claims": [
        "census-block-is-postal-block",
        "2011-geography-is-current",
        "portal-view-is-redistributable-geometry"
      ]
    }
  ],
