  "artifact_partitions": [
    {
      "id": "typed-five-digit-postal-object",
      "contents": "Pinned code, object type, establishment or service label, address or locality context, observed time, validity and authority."
    },
    {
      "id": "official-postal-surface",
      "contents": "Exact rights-cleared operator surface explicitly bound to the same code, object type, edition and validity."
    },
    {
      "id": "derived-postal-review-surface",
      "contents": "Optional non-canonical surface with permitted inputs, method, uncertainty, exclusions, topology, time, version and digests."
    },
    {
      "id": "administrative-context",
      "contents": "Commune, daïra and wilaya identity and permitted geometry kept separate from postal assignments."
    },
    {
      "id": "physical-address-and-building",
      "contents": "Rights-cleared civic-address points and building geometry plus a stable explicit relation, with private attributes removed."
    },
    {
      "id": "commercial-topographic-context",
      "contents": "INCT or cadastral products retained outside public artifacts unless exact contract and redistribution terms allow them."
    },
    {
      "id": "community-odbl",
      "contents": "OSM roads, addresses and buildings in a separate ODbL-compatible validation partition."
    },
    {
      "id": "private-and-restricted",
      "contents": "Recipients, accounts, correspondence, query logs, residents, owners, titles, credentials and security-sensitive features."
    }
