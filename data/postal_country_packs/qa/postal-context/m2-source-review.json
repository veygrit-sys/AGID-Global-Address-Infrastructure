{
  "schema_version": "agid-postal-qa-m2-source-review-v0.1",
  "country_code": "QA",
  "m2_criterion": {
    "id": "M2_current_official_inwani_context",
    "definition": "A current, complete-for-declared-coverage, rights-cleared official Qatar Inwani civic-address dataset provides explicit zone/street/building identifiers and source-supplied georeferencing with stable source relations. Pin publisher, scope, edition, valid-time, retrieval time, SHA-256, artifact-specific C0/open-licence applicability or permission, attribution and third-party rights, CRS/datum/axis order and uncertainty. Reproducibly transform and validate uniqueness, missingness, identifier joins, geometry and coverage; publish approved immutable digest-pinned artifacts and verify the actual QA AGID loader/API. Use postal_code=null and official_postal_geometry=none unless a separate authoritative postal assignment and surface is proven. P.O. boxes, administrative zones, roads and generic geocoder Postal fields never manufacture postcodes or postal polygons. Building display requires a permitted explicit civic-address relation; building footprints require their own source and identifier join, not proximity, interpolation, containment or an unverified geocoder candidate. Policy documents, service schemas, counts, census aggregates and synthetic tests alone cannot satisfy M2."
  },
  "definition_basis": {
    "previous_manifest": null,
    "previous_definition": null,
    "review_rule": "Individually defined from Qatar Post Inwani semantics, UPU 08/2024, current public CGIS metadata and NPC June 2026 C0 licensing policy. No normal-postcode requirement is invented; complete-for-declared-coverage address evidence is still mandatory."
  },
