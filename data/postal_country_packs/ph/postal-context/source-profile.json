    {
      "id": "R1_public_reference",
      "meaning": "Public official pages, specifications, catalogs or viewers retained as references; access does not imply row, data or map redistribution rights."
    },
    {
      "id": "R2_source_specific_reuse",
      "meaning": "An exact artifact whose provider terms permit recorded fields and derivatives, with provider, permission, edition, coverage, schema, scale, CRS, validity, attribution and digest pinned."
    },
    {
      "id": "R3_controlled_approval_or_contract",
      "meaning": "Request-delivered, paid, licensed, credentialed, restricted or conditional material used and redistributed only as specifically permitted."
    },
    {
      "id": "R4_validation_only",
      "meaning": "Personal, statistical microdata, query, title, unclear-license, viewer-only or non-redistributable evidence may detect discrepancies but cannot become public output."
