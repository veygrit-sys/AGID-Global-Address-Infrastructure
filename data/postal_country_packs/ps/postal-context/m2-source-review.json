  "m2_criterion": {
    "id": "M2_official_p3_postal_areas",
    "definition": "A current, complete, rights-cleared PS P3 postal-area release links the official code/locality assignment list to actual official polygon or multipolygon records by explicit source identifiers. Pin publisher, coverage, edition and validity, retrieval time, SHA-256, exact licence version and attribution, CRS/datum/axis order, reproducible transformation, geometry/topology and code-join validation, and exception handling. Publish approved immutable digest-pinned artifacts and verify the real PS AGID loader/API. P7 delivery-point codes and coordinates stay a separate authority layer; a P3 polygon, P7 suffix, locality name, administrative overlap or nearest feature cannot supply a house number or building without a separately permitted explicit address/building relation. Preserve PS identity and source-stated territorial coverage. A sample, catalog entry, partial download, historical list, reference document or synthetic test alone cannot achieve M2."
  },
  "limits": {
    "max_reference_bytes": 4194304,
    "max_p3_polygon_transfer_bytes": 16777216,
    "timeout_ms": 25000
  },
