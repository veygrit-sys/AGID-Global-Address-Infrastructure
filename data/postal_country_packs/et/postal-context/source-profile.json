  "artifact_partitions": [
    { "id": "typed-four-digit-postal-object", "contents": "Pinned code, object type, branch or delivery-office context, observed time, validity and authority." },
    { "id": "official-postal-surface", "contents": "Exact rights-cleared operator surface explicitly bound to the same code, object type, edition and validity." },
    { "id": "derived-postal-review-surface", "contents": "Optional non-canonical surface with permitted inputs, method, uncertainty, exclusions, topology, time, version and digests." },
    { "id": "administrative-context", "contents": "Region, zone, woreda, sub-city, kebele and neighbourhood identity and permitted geometry kept separate from postal assignments." },
    { "id": "edas-address-and-building", "contents": "Rights-cleared digital-address points, parcels and buildings plus stable explicit relations, with private attributes removed." },
    { "id": "official-geospatial-context", "contents": "Exact NSDI or city artifacts retained under their dataset-specific access, licence and redistribution terms." },
    { "id": "community-odbl", "contents": "OSM roads, places, addresses and buildings in a separate ODbL-compatible validation partition." },
    { "id": "private-and-restricted", "contents": "Recipients, households, residents, owners, titles, correspondence, queries, credentials and security-sensitive features." }
  ],
  "assignment_observation_gate": {
    "maximum_claim": "official-single-postal-object-or-branch-observation",
    "required": ["official-operator-page-or-endpoint", "successful-response", "normalized-four-digit-code-when-explicit", "typed-postal-object", "observed-at", "request-purpose", "query-minimisation", "terms-and-rate-policy", "selected-fields", "request-response-sha256", "source-provenance"],
    "failure_mode": "metadata-only-or-unverified-observation"
  },
  "geometry_promotion_gate": {
    "maximum_claim": "official-explicit-surface-or-derived-noncanonical-review-geometry",
    "required": ["same-code-and-object-type", "resource-permission", "validity", "schema", "source-crs-and-axis-order", "feature-and-geometry-sha256", "topology-validation", "uncertainty-and-derived-lineage-when-modified"],
    "failure_mode": "no-published-national-postcode-polygons-and-never-infer-from-branch-administration-edas-extent-proximity-or-model"
  },
  "building_promotion_gate": {
    "maximum_claim": "explicit-rights-cleared-edas-or-authoritative-address-linked-building",
    "required": ["authoritative-building-or-parcel-geometry", "source-defined-stable-address-relation", "same-feature-or-reviewed-crosswalk", "validity", "ambiguity-review", "privacy-review", "geometry-provenance", "sha256"],
    "failure_mode": "postal-administrative-and-address-candidate-context-only-no-building-claim"
  },
  "realtime_and_model": {
    "permitted_roles": ["single-observation-validation", "normalization", "spatial-indexing", "join-validation", "drift-detection", "review-prioritization", "derived-surface-generation", "geometry-compression-with-error-bounds"],
    "prohibited_roles": ["invent-current-assignment-or-official-boundary", "turn-branch-administration-edas-extent-buffer-voronoi-route-or-model-into-official-postal-polygon", "infer-address-building-occupant-owner-title-or-delivery-entitlement"],
    "outage_rule": "timeout-empty-blocked-or-unavailable-is-unknown-not-no-assignment"
  },
  "hosting": {
    "hugging_face_role": "rights-cleared-versioned-derived-artifact-store",
    "cloudflare_role": "metadata-and-permitted-index-serving",
    "production_read_rule": "pin-release-or-hub-commit-and-verify-shard-digests",
    "restricted_data_rule": "private-gated-or-external-only-for-personal-household-parcel-title-owner-query-log-credential-and-access-controlled-data"
  }
