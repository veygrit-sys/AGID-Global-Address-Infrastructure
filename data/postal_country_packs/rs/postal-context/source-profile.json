  "artifact_partitions": [
    { "id": "five-digit-postal-assignment", "rule": "Pošta Srbije postcode and destination-office assertions retain five-digit text, source type, capture time, purpose, terms, schema and digest; office coordinates never create a perimeter." },
    { "id": "six-digit-pak-routing", "rule": "PAK retains six-digit text, street side, house-number range, operator lineage and validity and is a route/address-range or non-area unless separately proven." },
    { "id": "operator-query-and-api", "rule": "Public lookup and WSP responses retain purpose, access basis, request/response scope, freshness and digest; credentials, personal contacts and shipment payloads stay private." },
    { "id": "official-open-address", "rule": "RGZ unique address code, public components, house-number point, cadastral references, SODL attribution, download date, URL, transformations, schema, CRS and postal linkage remain separately auditable." },
    { "id": "building-and-cadastral-context", "rule": "Building geometry, parcel, object-part reference, address point, property record and explicit address-building relation remain distinct; protected fields never enter public artifacts." },
    { "id": "derived-postal-or-pak-surface", "rule": "Rights-cleared address membership may create a derived surface or route with method, members, exclusions, uncertainty, validation, validity and lineage; it is never official Pošta Srbije or RGZ postal geometry." },
    { "id": "administration-coverage-and-territory", "rule": "Spatial units, source coverage, exclusions, territorial vintage, delivery state and sovereignty policy remain separate and never infer one another." },
    { "id": "private-and-restricted", "rule": "Addressees, residents, owners, rightsholders, occupants, title/value records, contacts, credentials, shipment data and delivery instructions never enter public artifacts." },
    { "id": "synthetic-conformance", "rule": "Non-production fixture metadata only; never promotion evidence." }
